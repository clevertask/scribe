{
  "name": "@clevertask/scribe",
  "version": "0.1.21",
  "private": false,
  "description": "A Radix-based Tiptap rich text editor with a Notion-style block interface for viewing and creating content. Perfect for diverse needs like notes, documents, AI chat, Markdown parsing, and comments.",
  "keywords": [
    "block-based",
    "editor",
    "javascript",
    "notion",
    "prosemirror",
    "react",
    "rich-text-editor",
    "tiptap",
    "typescript",
    "wysiwyg"
  ],
  "homepage": "https://github.com/clevertask/scribe#readme",
  "bugs": {
    "url": "https://github.com/clevertask/scribe/issues"
  },
  "license": "MIT",
  "author": "CleverTask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clevertask/scribe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./styles.css": "./dist/main.css",
    "./dist/main.css": "./dist/main.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check:tiptap-contract": "node scripts/sync-tiptap-contract.mjs --check",
    "dependency-update:post": "node scripts/sync-tiptap-contract.mjs --write",
    "dev": "vite",
    "e2e": "pnpm run e2e:prepare && playwright test && pnpm run e2e:build-consumer",
    "e2e:build-consumer": "pnpm --dir e2e/consumer exec vite build",
    "e2e:dev": "pnpm run e2e:prepare && playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:prepare": "pnpm run build && node scripts/prepare-package-consumer.mjs",
    "e2e:serve": "pnpm --dir e2e/consumer exec vite --force --strictPort --host 127.0.0.1 --port 5174",
    "build": "vite build && npm run build:style && tsc -p tsconfig.types.json --noCheck && node scripts/verify-headless-schema-build.mjs",
    "build:style": "mkdir -p ./dist && cp ./lib/styles/main.css ./dist/main.css",
    "lint": "oxlint . --report-unused-disable-directives --deny-warnings",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node scripts/sync-tiptap-contract.test.mjs && vitest run --config vitest.config.ts",
    "test:tiptap-contract": "node scripts/sync-tiptap-contract.test.mjs",
    "validate:deps": "pnpm run check:tiptap-contract && pnpm run fmt:check && pnpm run lint && pnpm run test && pnpm run e2e:install && pnpm run e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "tippy.js": "^6.3.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@radix-ui/themes": "^3.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bullet-list": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-dropcursor": "3.31.3",
    "@tiptap/extension-emoji": "3.31.3",
    "@tiptap/extension-focus": "3.31.3",
    "@tiptap/extension-gapcursor": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-list-keymap": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-ordered-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/html": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@radix-ui/themes": ">=3.3.0",
    "@tiptap/pm": "3.31.3",
    "react": ">=18.3.1 <20.0.0",
    "react-dom": ">=18.3.1 <20.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
